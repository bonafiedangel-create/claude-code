{
 "hooks": [
  {"name": "Curiosity Gap",
   "match": ["\\bwhy\\b", "\\bnobody (tells|talks about|shows)\\b", "\\buntil\\b", "\\balmost\\b",
             "\\bexcept\\b", "\\breal reason\\b"]},
  {"name": "Direct Callout",
   "match": ["^\\s*(if )?you'?re\\b", "\\bif you\\b", "\\byou (still|probably|might)\\b",
             "\\byou'?ve been\\b"]},
  {"name": "Contrarian / Myth-Bust",
   "match": ["\\bwrong\\b", "\\bmyth\\b", "\\beveryone (thinks|believes|says)\\b", "\\bactually\\b",
             "\\bnot what you think\\b"]},
  {"name": "Stat Shock",
   "match": ["^\\s*\\d", "\\d+\\s?%", "\\$\\d", "\\b\\d+x\\b", "\\bin \\d+ (seconds|minutes|days)\\b"]},
  {"name": "Loss Aversion / Warning",
   "match": ["\\bstop\\b", "\\bnever\\b", "\\bmistake\\b", "\\bwasting\\b", "\\bbefore (you|it)\\b",
             "\\bcost(ing)? you\\b"]},
  {"name": "Listicle Tease",
   "match": ["\\b\\d+ (ways|reasons|things|tips|signs|mistakes|rules)\\b"]},
  {"name": "Before/After Transformation",
   "match": ["\\bwent from\\b", "\\bin \\d+ (days|weeks|months|years)\\b", "\\bturned into\\b",
             "\\bfrom .* to .*\\b"]},
  {"name": "Confession / Personal Story",
   "match": ["\\bi (tried|spent|did|quit|built|found|discovered)\\b", "\\bmy (story|mistake)\\b"]},
  {"name": "Question Hook",
   "match": ["\\?\\s*$", "^\\s*(have you|did you|do you|have you ever)\\b"]},
  {"name": "Challenge / Dare",
   "match": ["\\btry (this|it)\\b", "\\bbet you\\b", "\\bcan'?t\\b", "\\bi dare you\\b"]}
 ]
}
