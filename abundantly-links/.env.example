# Copy these names into Vercel › Project › Settings › Environment Variables.
# None of them are needed to build; each one switches a feature on.

# Keystatic editor (GitHub mode) — filled in by Keystatic's setup screen
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Only if the site moves to its own repo:
# PUBLIC_KEYSTATIC_REPO=bonafiedangel-create/abundantly-links
# PUBLIC_KEYSTATIC_PATH_PREFIX=

# Media kit form (resend.com, free tier)
RESEND_API_KEY=
MEDIA_KIT_TO=
MEDIA_KIT_FROM=

# Click counts for /stats (Vercel › Storage › Upstash Redis, free tier, sets these for you)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STATS_PASSWORD=
